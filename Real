  <script>
    (function () {
      var youEl = document.getElementById("out-you");
      var themEl = document.getElementById("out-them");
      var textEl = document.getElementById("out-text");

      function val(name) {
        return document.querySelector('input[name="' + name + '"]:checked').value;
      }

      function update() {
        var program = val("program");
        var role = val("role");
        var focus = val("focus");
        var copy = {
          mentee: {
            you: program + " team, mentee",
            them: "Experienced " + program + " team",
            text: "You’d be matched with an experienced " + program + " team ready to guide you on " + focus + "."
          },
          mentor: {
            you: program + " team, mentor",
            them: "Newer " + program + " team",
            text: "You’d be matched with a newer " + program + " team looking for guidance on " + focus + "."
          },
          peer: {
            you: program + " team, peer",
            them: "Fellow " + program + " team",
            text: "You’d be matched with a fellow " + program + " team to trade ideas and work on " + focus + " together."
          }
        }[role];
        youEl.textContent = copy.you;
        themEl.textContent = copy.them;
        textEl.textContent = copy.text;
      }

      document.querySelectorAll(".picker input").forEach(function (el) {
        el.addEventListener("change", update);
      });
      update();
      document.getElementById("year").textContent = new Date().getFullYear();
    })();
  </script>
